#!/usr/bin/env bash
#
# Makes Voice Focus the default microphone while it is running, and puts the
# previous one back when it stops.
#
#   studio-effects-voice-default claim
#   studio-effects-voice-default release
#
# Applications that follow "default" -- which is most of them, and the only
# option in some -- cannot otherwise benefit from the filter without being
# reconfigured one by one.
#
# Restoring on the way out is not optional. The voice_focus node only exists
# while the service runs, so leaving the default pointing at it after a stop
# leaves every one of those applications pointing at a device that is gone.
#
# The default is set by node name rather than by the numeric id wpctl takes,
# because ids are handed out afresh each time a node appears: an id saved on
# start means nothing by the time it is used on stop.
#
# The filter's own capture is pinned to the microphone that was the default,
# before the default moves. Left to follow "default" it would follow itself,
# which WirePlumber refuses, and fall back to the highest-priority source left
# -- a Bluetooth headset's, whenever one is connected, since those outrank the
# built-in microphone. Recording from it switches the headset from A2DP into
# its hands-free profile, and when that switch fails it can leave PipeWire
# answering nobody.
#
# Every PipeWire call is bounded. A PipeWire that has stopped answering would
# otherwise hold the stop past systemd's timeout, the release would be killed,
# and the default would be left pointing at a node that no longer exists.

set -uo pipefail

FILTER=voice_focus
CAPTURE=capture.voice_focus
STATE="${XDG_RUNTIME_DIR:-/tmp}/studio-effects-voice-previous-source"
DEADLINE=40   # quarter-seconds to wait for the node to appear
BOUND=3       # seconds any one PipeWire call may take

# Off by default only if the user says so; the point of the feature is that it
# happens without being asked for.
case "${VOICE_SET_DEFAULT:-yes}" in
    no|off|false|0) exit 0 ;;
esac

source_key() {
    timeout "$BOUND" pw-metadata -n default 2>/dev/null \
        | grep "key:'$1'" | tail -1 \
        | sed -n "s/.*value:'{\"name\":\"\([^\"]*\)\"}'.*/\1/p"
}

# The microphone actually in use, which is what claim has to remember.
current_default() { source_key default.audio.source; }

# The one asked for, which outlives the node it names. By the time release runs
# the filter has exited and WirePlumber has already fallen back to another
# microphone, so only this still says the filter holds the default.
configured_default() { source_key default.configured.audio.source; }

set_default() {
    timeout "$BOUND" pw-metadata -n default 0 default.configured.audio.source \
        "{\"name\":\"$1\"}" Spa:String:JSON >/dev/null 2>&1
}

filter_published() {
    timeout "$BOUND" pw-link -o 2>/dev/null | grep -q "^${FILTER}:"
}

node_id() {
    timeout "$BOUND" pw-cli ls Node 2>/dev/null | awk -v name="$1" '
        /^\tid [0-9]+,/ { id = $2; sub(/,/, "", id) }
        $1 == "node.name" && $3 == "\"" name "\"" { print id; exit }'
}

# Holds the filter's capture to one microphone, by name, whatever the default.
pin_capture() {
    local id
    id=$(node_id "$CAPTURE")
    [ -n "$id" ] || return 0
    timeout "$BOUND" pw-metadata -n default "$id" target.object "$1" >/dev/null 2>&1
}

case "${1:-}" in
claim)
    previous=$(current_default)
    # Guard against remembering ourselves: a restart would otherwise record
    # voice_focus as the thing to go back to, and the real microphone would be
    # forgotten for good.
    if [ -n "$previous" ] && [ "$previous" != "$FILTER" ]; then
        printf '%s\n' "$previous" > "$STATE"
    fi

    # systemd considers the unit started once pipewire is running, which is
    # before the filter has published anything.
    for _ in $(seq "$DEADLINE"); do
        filter_published && break
        sleep 0.25
    done
    filter_published || exit 0

    # Pin first: the moment the default moves, an unpinned capture is relinked.
    # On a restart the default is still the filter, and the real microphone is
    # the one remembered last time.
    microphone=$(cat "$STATE" 2>/dev/null)
    [ -n "$microphone" ] && pin_capture "$microphone"
    set_default "$FILTER"
    ;;

release)
    previous=$(cat "$STATE" 2>/dev/null)
    rm -f "$STATE"
    [ -n "$previous" ] || exit 0
    # Only put it back if we are the one still holding it; a user who chose a
    # different microphone in the meantime meant it.
    [ "$(configured_default)" = "$FILTER" ] || exit 0
    set_default "$previous"
    ;;

*)
    echo "usage: ${0##*/} claim|release" >&2
    exit 2
    ;;
esac
exit 0
